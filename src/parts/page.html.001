('versionBadge').textContent='v'+(SNAP.version||'dev');let e=$('env');e.innerHTML='<div class="row"><div><b>'+SNAP.downstream_keys.length+'</b><div class="muted">下游 API Key</div></div><div><b>'+SNAP.resources.length+'</b><div class="muted">上游资源</div></div><div class="grow"></div><div class="muted mono">'+esc(SNAP.config_path||'未找到 config.yaml')+'</div></div>'+(SNAP.config_error?'<div class="note" style="margin-top:12px">'+esc(SNAP.config_error)+'</div>':'');let out='';for(const r of SNAP.routes){out+='<div class="route"><div class="row"><div class="grow"><h3 style="margin:0">'+esc(r.name)+' <span class="'+(r.enabled?'green':'muted')+'">'+(r.enabled?'● 启用':'● 停用')+'</span></h3><div class="muted">Key '+esc(r.key_hint)+' · 匹配模型 <span class="mono">'+esc((r.match_models||['*']).join(', '))+'</span> · '+r.candidates.length+' 个候选</div></div><button onclick="diagnose(\''+esc(r.id)+'\')">测试路由</button><button onclick="openEditor(\''+esc(r.id)+'\')">编辑</button><button onclick="delRoute(\''+esc(r.id)+'\')">删除</button></div><div class="chain">';r.candidates.forEach((c,i)=>{out+='<div class="pill"><b>'+esc(c.name)+'</b> <span class="muted">'+esc(c.provider)+(c.auth_index?' / '+esc(c.auth_index):'')+(c.override_model?' · → '+esc(c.override_model):' · 保持原模型')+'</span></div>'+(i<r.candidates.length-1?'→':'')});out+='</div></div>'}if(!out)out='<div class="card muted">还没有路由。点击“新建路由”创建第一条。</div>';$('routes').innerHTML=out}function openEditor(id){EDIT=id?JSON.parse(JSON.stringify(SNAP.routes.find(x=>x.id===id))):{id:'',name:'',key_fingerprint:'',key_hint:'',enabled:true,match_models:['*'],candidates:[]};$('editTitle').textContent=id?'编辑路由':'新建路由';$('rName').value=EDIT.name||'';$('rEnabled').value=String(EDIT.enabled!==false);$('rModels').value=(EDIT.match_models||['*']).join(',');$('rKey').innerHTML=SNAP.downstream_keys.map(k=>'<option value="'+esc(k.fingerprint)+'" data-hint="'+esc(k.hint)+'">'+esc(k.hint)+'</option>').join('');if(EDIT.key_fingerprint)$('rKey').value=EDIT.key_fingerprint;renderCands();$('editModal').classList.add('open')}function closeEditor(){$('editModal').classList.remove('open')}function resOptions(sel){return SNAP.resources.map(r=>'<option value="'+esc(r.id)+'" '+(r.id===sel?'selected':'')+'>'+esc(r.kind+' · '+r.provider+' · '+r.display_name+(r.key_hint?' · '+r.key_hint:''))+'</option>').join('')}function renderCands(){let x='';EDIT.candidates.forEach((c,i)=>{x+='<div class="candidate"><div><label>上游资源</label><select onchange="pickRes('+i+',this.value)">'+resOptions(c.resource_id)+'</select></div><div><label>显示名称</label><input value="'+esc(c.name||'')+'" oninput="EDIT.candidates['+i+'].name=this.value"></div><div><label>覆盖模型 / alias（可留空）</label><input value="'+esc(c.override_model||'')+'" placeholder="留空 = 保持客户端 model" oninput="EDIT.candidates['+i+'].override_model=this.value"></div><div><label>状态</label><select onchange="EDIT.candidates['+i+'].enabled=this.value===\'true\'"><option value="true" '+(c.enabled!==false?'selected':'')+'>启用</option><option value="false" '+(c.enabled===false?'selected':'')+'>停用</option></select></div><div class="row" style="gap:4px"><button onclick="moveCand('+i+',-1)">↑</button><button onclick="moveCand('+i+',1)">↓</button><button onclick="EDIT.candidates.splice('+i+',1);renderCands()">×</button></div></div>'});$('cands').innerHTML=x}function clearOverrides(){EDIT.candidates.forEach(c=>c.override_model='');renderCands()}function moveCand(i,d){let j=i+d;if(j<0||j>=EDIT.candidates.length)return;let x=EDIT.candidates[i];EDIT.candidates[i]=EDIT.candidates[j];EDIT.candidates[j]=x;renderCands()}function addCandidate(){let r=SNAP.resources[0];if(!r)return alert('当前没有可选上游资源');EDIT.candidates.push(fromRes(r));renderCands()}function fromRes(r){return{id:'',name:r.display_name,resource_id:r.id,resource_kind:r.kind,provider:r.provider,auth_id:r.auth_id||'',auth_index:r.auth_index||'',override_model:'',enabled:true}}function pickRes(i,id){let r=SNAP.resources.find(x=>x.id===id);if(!r)return;let old=EDIT.candidates[i];let over=old.override_model||'';EDIT.candidates[i]=fromRes(r);EDIT.candidates[i].override_model=over;renderCands()}async function saveRoute(){let sel=$('rKey');let hint=sel.options[sel.selectedIndex]?.dataset.hint||'';let p={ID:EDIT.id||'',Name:$('rName').value,KeyFingerprint:sel.value,KeyHint:hint,Enabled:$('rEnabled').value==='true',MatchModels:$('rModels').value,Candidates:EDIT.candidates};SNAP=await api({action:'save_route',payload:JSON.stringify(p)});closeEditor();render()}async function delRoute(id){if(!confirm('删除这条路由？'))return;SNAP=await api({action:'delete_route',id});render()}function diagnose(id){DIAG=id;let r=SNAP.routes.find(x=>x.id===id);$('diagModel').value=(r.match_models||[]).find(x=>x!=='*'&&!x.includes('*')&&!x.includes('?'))||'';$('diagModal').classList.add('open');runDiag()}function closeDiag(){$('diagModal').classList.remove('open')}async function runDiag(){let d=await api({action:'diagnose',id:DIAG,model:$('diagModel').value});if(!d.ok){$('diagBody').innerHTML='<div class="note">'+esc(d.error)+'</div>';return}let h='<div class="'+(d.model_matches?'oknote':'note')+'">模型匹配：'+(d.model_matches?'✓ 是':'✗ 否')+'；预计首选：'+esc(d.expected_first||'无可用候选')+'</div><table style="width:100%;