margin-top:12px;border-collapse:collapse"><tr><th align=left>顺序</th><th align=left>候选</th><th align=left>Provider</th><th align=left>AuthIndex</th><th align=left>模型</th><th align=left>状态</th></tr>';for(const c of d.candidates){h+='<tr><td>'+c.order+'</td><td>'+esc(c.name)+'</td><td>'+esc(c.provider)+'</td><td class="mono">'+esc(c.auth_index)+'</td><td class="mono">'+esc(c.effective_model)+'</td><td>'+(c.available?'✓ 可用':'✗ 不可用')+'</td></tr>'}h+='</table>';if(d.last_trace){h+='<h3>最近一次真实执行</h3><div class="'+(d.last_trace.success?'oknote':'note')+'">'+esc(d.last_trace.at)+' · '+(d.last_trace.success?'✓ 成功，最终 '+esc(d.last_trace.final):'✗ '+esc(d.last_trace.error||'失败'))+'</div><div class="diag">'+esc((d.last_trace.attempts||[]).map((a,i)=>(i+1)+'. '+a.candidate+' | '+a.provider+' | '+a.auth_index+' | '+a.model+' | '+(a.status||a.error)+' | '+a.duration_ms+'ms').join('\n'))+'</div>'}h+='<h3>真实请求验证</h3><div class="muted">插件资源页不直接发送真实模型请求，避免无认证页面被滥用产生额度消耗。复制下面 curl，在可信终端执行，再回到这里刷新，即可看到上面的真实候选尝试轨迹；同时到 CPA Usage / Request Log 核对最终 provider/auth_index。</div><div class="diag">'+esc(d.curl)+'</div>';$('diagBody').innerHTML=h}
load().catch(e=>$('env').innerHTML='<div class="note">加载失败：'+esc(e)+'</div>');
</script></body></html>
